<?xml version="1.0" encoding="utf-8"?>
<!--
    This module promotes RetranscribeWorker to the foreground, so it declares what that needs
    rather than relying on the app to do it. Lint enforces this per module:
    `SpecifyForegroundServiceType` fails on the
    `ForegroundInfo(..., FOREGROUND_SERVICE_TYPE_MEDIA_PROCESSING)` call unless the module's own
    merged manifest overrides WorkManager's service with a matching type. mediaProcessing, not
    dataSync (core/backup's own override, for a different worker) — this is the same operation
    RecordingForegroundService's own manifest already classifies as mediaProcessing when it runs
    transcription inline after a live recording instead of from this manual-retry worker.

    The app declares the union of every type any worker in it uses; `tools:node="merge"` combines
    them rather than conflicting.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing"
            tools:node="merge" />
    </application>
</manifest>
