<?xml version="1.0" encoding="utf-8"?>
<!--
    Excludes the credential DataStore from cloud backup (API 31+).
    Encrypted keys are useless after restore because the AndroidKeyStore key never leaves the device;
    the cross-app read-through re-populates from a sibling on first launch.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
