{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twobits.app/contracts/price-drop/v2/promotion.schema.json",
  "title": "Promotion",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "applicability", "confidence", "source"],
  "properties": {
    "code": { "type": ["string", "null"] },
    "description": { "type": "string" },
    "discount": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "amount": { "$ref": "money.schema.json" },
        "percentage": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "validFrom": { "type": ["string", "null"], "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "applicability": {
      "enum": ["CONFIRMED_FOR_LISTING", "CONFIRMED_FOR_PRODUCT", "MERCHANT_WIDE", "POSSIBLY_APPLICABLE", "UNKNOWN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "$ref": "product-offer.schema.json#/$defs/providerRef" }
  }
}
