{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twobits.app/contracts/price-drop/v2/product-offer.schema.json",
  "title": "Product offer",
  "$defs": {
    "providerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executionMode"],
      "properties": {
        "id": { "type": "string" },
        "executionMode": { "enum": ["BYOK", "PRO"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["merchant", "itemPrice", "totalPrice", "availability", "condition", "productUrl", "observedAt", "promotions", "provider"],
  "properties": {
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "listingId": { "type": ["string", "null"] },
    "seller": { "type": ["string", "null"] },
    "itemPrice": { "$ref": "money.schema.json" },
    "shippingPrice": { "oneOf": [{ "$ref": "money.schema.json" }, { "type": "null" }] },
    "totalPrice": { "$ref": "money.schema.json" },
    "availability": { "enum": ["IN_STOCK", "OUT_OF_STOCK", "PREORDER", "UNKNOWN"] },
    "condition": { "enum": ["NEW", "USED", "REFURBISHED", "UNKNOWN"] },
    "productUrl": { "type": "string", "format": "uri" },
    "observedAt": { "type": "string", "format": "date-time" },
    "promotions": { "type": "array", "items": { "$ref": "promotion.schema.json" } },
    "provider": { "$ref": "#/$defs/providerRef" }
  }
}
