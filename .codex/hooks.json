{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/ktlint-post-edit.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)\\.codex\\hooks\\ktlint-post-edit.py\"",
            "timeout": 180,
            "statusMessage": "Formatting changed Kotlin modules"
          }
        ]
      }
    ]
  }
}
