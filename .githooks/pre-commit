#!/bin/sh
# Pre-commit: auto-format staged Kotlin files then verify no violations remain.
# Skip with: SKIP_KTLINT=1 git commit

[ "${SKIP_KTLINT:-0}" = "1" ] && exit 0

REPO_ROOT=$(git rev-parse --show-toplevel)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep "\.kt$" || true)
[ -z "$STAGED" ] && exit 0

# ── Scrybe ────────────────────────────────────────────────────────────────────
SCRYBE_KT=$(echo "$STAGED" | grep "^apps/scrybe/" || true)
if [ -n "$SCRYBE_KT" ]; then
    MODULES=$(echo "$SCRYBE_KT" \
        | sed 's|^apps/scrybe/||' \
        | sed 's|/src/.*||' \
        | sort -u \
        | while IFS= read -r m; do printf ":%s\n" "$(echo "$m" | tr '/' ':')"; done)

    FORMAT_TASKS=$(echo "$MODULES" | awk '{print $0 ":ktlintFormat"}' | tr '\n' ' ')
    CHECK_TASKS=$(echo "$MODULES"  | awk '{print $0 ":ktlintCheck"}'  | tr '\n' ' ')

    printf "ktlint: formatting %s\n" "$(echo "$MODULES" | tr '\n' ' ')"
    (cd "$REPO_ROOT/apps/scrybe" && ./gradlew $FORMAT_TASKS -q 2>&1) || true

    # Re-stage files that the formatter may have modified
    echo "$SCRYBE_KT" | while IFS= read -r f; do git add "$f"; done

    # Fail fast if unfixable violations remain
    if ! (cd "$REPO_ROOT/apps/scrybe" && ./gradlew $CHECK_TASKS -q 2>&1); then
        echo ""
        echo "ktlint: violations remain after auto-format. Fix them before committing."
        echo "        (bypass with SKIP_KTLINT=1 git commit)"
        exit 1
    fi
    printf "ktlint: all checks passed\n"
fi
